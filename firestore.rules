rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null && request.auth.token.email == 'juyeonglee911029@gmail.com';
    }
    function hasValidGender(data) {
      return data.keys().hasAny(['gender']) && (data.gender == 'male' || data.gender == 'female');
    }
    function hasValidCountry(data) {
      return data.keys().hasAny(['country'])
        && data.country is string
        && data.country.size() > 0
        && data.country.size() <= 80
        && data.country != 'Global';
    }
    function hasValidAge(data) {
      return data.keys().hasAny(['age'])
        && data.age is int
        && data.age >= 13
        && data.age <= 130;
    }
    function hasCompletedOnboarding(data) {
      return hasValidGender(data) && hasValidCountry(data) && hasValidAge(data);
    }
    function hasNoOnboardingFields(data) {
      return !data.keys().hasAny(['gender', 'country', 'age']);
    }
    function hasValidProfileState(data) {
      return hasNoOnboardingFields(data) || hasCompletedOnboarding(data);
    }
    function hasImmutableOnboardingFields() {
      return hasValidProfileState(request.resource.data)
        && (!hasValidGender(resource.data) || request.resource.data.gender == resource.data.gender)
        && (!hasValidAge(resource.data) || request.resource.data.age == resource.data.age);
    }
    function isSafePublicProfile(data) {
      return data.keys().hasOnly(['name', 'image', 'gender', 'country', 'age', 'isSubscribed', 'isPublic', 'updatedAt'])
        && data.keys().hasAll(['name', 'image', 'gender', 'country', 'isSubscribed', 'isPublic', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.image is string
        && hasCompletedOnboarding(data)
        && data.isPublic == true
        && data.isSubscribed is bool
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['age']) || (data.age is int && data.age > 0 && data.age <= 130));
    }
    function publicProfileMatchesPrivate(userId) {
      return request.resource.data.gender == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.gender
        && request.resource.data.country == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.country
        && request.resource.data.age == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.age;
    }
    function isSafePresence(data) {
      return data.keys().hasOnly(['userId', 'name', 'image', 'gender', 'country', 'age', 'lastSeenAt', 'updatedAt'])
        && data.keys().hasAll(['lastSeenAt', 'updatedAt'])
        && data.lastSeenAt is timestamp
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(['userId'])
          || (
            data.keys().hasAll(['userId', 'name', 'image', 'gender', 'country', 'age'])
            && data.userId is string
            && data.name is string
            && data.image is string
            && hasCompletedOnboarding(data)
            && data.age is int
            && data.age >= 0
            && data.age <= 130
          )
        );
    }
    function presenceMatchesPrivate(data) {
      return data.gender == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.gender
        && data.country == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.country;
    }
    function isValidEscrowOrder(data) {
      return data.keys().hasOnly(['buyerId', 'sellerId', 'productId', 'amount', 'status', 'createdAt', 'updatedAt', 'timeline'])
        && data.keys().hasAll(['buyerId', 'sellerId', 'productId', 'amount', 'status', 'createdAt', 'updatedAt', 'timeline'])
        && data.buyerId is string
        && data.sellerId is string
        && data.buyerId != data.sellerId
        && data.productId is string
        && data.amount is number
        && data.amount > 0
        && data.status == 'PAYMENT_HELD'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.timeline is list;
    }
    function isAllowedEscrowTransition() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timeline', 'updatedAt'])
        && request.resource.data.timeline is list
        && resource.data.timeline is list
        && request.resource.data.timeline.size() == resource.data.timeline.size() + 1
        && (
          (request.auth.uid == resource.data.sellerId && resource.data.status == 'PAYMENT_HELD' && request.resource.data.status == 'SHIPPING')
          || (request.auth.uid == resource.data.sellerId && resource.data.status == 'SHIPPING' && request.resource.data.status == 'IN_TRANSIT')
          || (request.auth.uid == resource.data.buyerId && resource.data.status == 'IN_TRANSIT' && request.resource.data.status == 'DELIVERED')
        );
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        (request.resource.data.authorId == resource.data.authorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))
      );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /marketItems/{itemId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /directories/{directoryId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /chatMessages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.expiresAt != null && request.time >= resource.data.expiresAt;
    }
    match /tetrisChatMessages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.expiresAt != null && request.time >= resource.data.expiresAt;
    }
    match /webrtcChatMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.expiresAt != null
        && (request.time >= resource.data.expiresAt
          || get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.status == 'ended');
    }
     match /depositRequests/{requestId} {
       allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
       allow update: if isMaster();
       allow delete: if false;
    }
    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isMaster());
      allow create: if isMaster() || (request.auth != null && request.auth.uid == userId && hasValidProfileState(request.resource.data));
      allow update: if isMaster() || (request.auth != null && request.auth.uid == userId && hasImmutableOnboardingFields());
      allow delete: if isMaster();
    }
    match /publicProfiles/{userId} {
      allow read: if resource.data.isPublic == true;
      allow read: if request.auth != null && (request.auth.uid == userId || isMaster());
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isSafePublicProfile(request.resource.data)
        && publicProfileMatchesPrivate(userId);
      allow delete: if false;
    }
    match /withdrawalRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isMaster();
       allow delete: if false;
     }
    match /transferRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid || isMaster());
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if isMaster();
      allow delete: if false;
    }
    match /escrowOrders/{orderId} {
      allow read: if request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isMaster());
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && isValidEscrowOrder(request.resource.data)
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.usdtBalance
          == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.usdtBalance - request.resource.data.amount;
      allow update: if isMaster() || (request.auth != null && isAllowedEscrowTransition());
      allow delete: if false;
    }
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isMaster();
    }
    match /contentSnapshots/{snapshotId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }
    match /stats/{statId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /visits/{visitId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /presence/{visitorId} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeenAt', 'updatedAt'])
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /publicPresence/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && isSafePresence(request.resource.data)
        && presenceMatchesPrivate(request.resource.data);
      allow delete: if false;
    }
    match /webrtcQueue/{userId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /webrtcCalls/{callId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /webrtcCandidates/{candidateId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && (resource.data.requesterId == request.auth.uid || resource.data.addresseeId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.addresseeId is string
        && request.resource.data.addresseeId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && (resource.data.requesterId == request.auth.uid || resource.data.addresseeId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined');
      allow delete: if request.auth != null
        && (resource.data.requesterId == request.auth.uid || resource.data.addresseeId == request.auth.uid);
    }
     match /friendMessages/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants
        && get(/databases/$(database)/documents/friendships/$(resource.data.friendshipId)).data.status == 'accepted';
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.status == 'accepted';
      allow update: if false;
       allow delete: if request.auth != null
         && request.auth.uid in resource.data.participants
         && resource.data.expiresAt != null
         && request.time >= resource.data.expiresAt;
     }
     match /friendCallRequests/{requestId} {
       allow read: if request.auth != null
         && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
       allow create: if request.auth != null
         && request.resource.data.callerId == request.auth.uid
         && request.resource.data.calleeId is string
         && request.resource.data.calleeId != request.auth.uid
         && request.resource.data.status == 'pending';
       allow update: if request.auth != null
         && resource.data.calleeId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
         && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined');
       allow delete: if request.auth != null
         && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
     }
     match /tetrisLobby/{lobbyId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /tetrisQueue/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.status == 'waiting' && request.resource.data.status == 'matched' && request.resource.data.matchedBy == request.auth.uid)
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /gameStakes/{stakeId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && request.resource.data.amount > 0;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'RESERVED'
        && request.resource.data.status == 'REFUNDED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refundedAt']);
      allow delete: if false;
    }
    match /gamePayouts/{payoutId} {
      allow read: if request.auth != null && (resource.data.winnerId == request.auth.uid || resource.data.loserId == request.auth.uid || isMaster());
      allow create: if request.auth != null && request.resource.data.winnerId == request.auth.uid && request.resource.data.payoutAmount == request.resource.data.amount * 2;
      allow update, delete: if false;
    }
    match /genderMatchStakes/{stakeId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && request.resource.data.amount > 0;
      allow update, delete: if false;
    }
    match /premiumSubscriptions/{subscriptionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && request.resource.data.amount == 30;
      allow update, delete: if false;
    }
    match /tetrisInvites/{inviteId} {
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow delete: if false;
    }
      function isTetrisParticipant(data) {
        return request.auth != null && (
          (data.keys().hasAny(['playerAId']) && data.playerAId == request.auth.uid) ||
          (data.keys().hasAny(['playerBId']) && data.playerBId == request.auth.uid)
        );
      }
      function isFixedTetrisParticipant(roomId, data) {
        return request.auth != null
          && data.keys().hasAll(['roomNumber', 'matchId'])
          && data.matchId == roomId
          && get(/databases/$(database)/documents/tetrisRoomAccess/$(roomId)).data.active == true
          && (
            get(/databases/$(database)/documents/tetrisRoomAccess/$(roomId)).data.playerAId == request.auth.uid
            || get(/databases/$(database)/documents/tetrisRoomAccess/$(roomId)).data.playerBId == request.auth.uid
          );
      }
      function canAccessTetrisRoom(roomId, data) {
        return isTetrisParticipant(data) || isFixedTetrisParticipant(roomId, data);
      }
      function hasValidTetrisBet(data) {
        return data.keys().hasAny(['betAmount'])
          && data.betAmount is number
          && data.betAmount >= 1
          && data.betAmount <= 100;
      }
      function preservesTetrisBet() {
        return (
          !resource.data.keys().hasAny(['betAmount'])
          && !request.resource.data.keys().hasAny(['betAmount'])
        ) || (
          resource.data.keys().hasAny(['betAmount'])
          && request.resource.data.keys().hasAny(['betAmount'])
          && request.resource.data.betAmount == resource.data.betAmount
        ) || (
          !resource.data.keys().hasAny(['betAmount'])
          && request.auth.uid == request.resource.data.playerAId
          && hasValidTetrisBet(request.resource.data)
        );
      }
      match /tetrisRoomAccess/{matchId} {
        allow read: if request.auth != null && (
          resource.data.playerAId == request.auth.uid || resource.data.playerBId == request.auth.uid
        );
        allow create: if request.auth != null && (
          request.resource.data.playerAId == request.auth.uid || request.resource.data.playerBId == request.auth.uid
        );
        allow update: if request.auth != null && (
          resource.data.playerAId == request.auth.uid
          || resource.data.playerBId == request.auth.uid
          || request.resource.data.playerAId == request.auth.uid
          || request.resource.data.playerBId == request.auth.uid
        );
        allow delete: if false;
      }
      match /tetrisRooms/{roomId} {
        allow read: if canAccessTetrisRoom(roomId, resource.data);
        allow create: if canAccessTetrisRoom(roomId, request.resource.data)
          && (!request.resource.data.keys().hasAny(['betAmount'])
            || (request.resource.data.playerAId == request.auth.uid && hasValidTetrisBet(request.resource.data)));
        allow update: if (canAccessTetrisRoom(roomId, resource.data) || canAccessTetrisRoom(roomId, request.resource.data)) && preservesTetrisBet();
        allow delete: if canAccessTetrisRoom(roomId, resource.data);
      }
  }
}
