rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /marketItems/{itemId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /directories/{directoryId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /chatMessages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.expiresAt != null && request.time >= resource.data.expiresAt;
    }
    match /depositRequests/{requestId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /stats/{statId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /visits/{visitId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /presence/{visitorId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /webrtcQueue/{userId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /webrtcCalls/{callId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /webrtcCandidates/{candidateId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /tetrisLobby/{lobbyId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /tetrisInvites/{inviteId} {
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow delete: if false;
    }
    match /tetrisRooms/{roomId} {
      allow read: if request.auth != null && (resource.data.playerAId == request.auth.uid || resource.data.playerBId == request.auth.uid);
      allow create: if request.auth != null && (request.resource.data.playerAId == request.auth.uid || request.resource.data.playerBId == request.auth.uid);
      allow update: if request.auth != null && (
        resource.data.playerAId == request.auth.uid ||
        resource.data.playerBId == request.auth.uid ||
        request.resource.data.playerAId == request.auth.uid ||
        request.resource.data.playerBId == request.auth.uid
      );
      allow delete: if false;
    }
  }
}
